# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# URL pública de la app (links en emails)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# IA (asistente)
GEMINI_API_KEY=

# Google Calendar / Meet (OAuth)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Emails
RESEND_API_KEY=

# Modo demo — si NEXT_PUBLIC_DEMO_PASSWORD está vacío, el botón de demo no aparece
NEXT_PUBLIC_DEMO_EMAIL=demo@psydesk.app
NEXT_PUBLIC_DEMO_PASSWORD=
# Protege /api/demo/reset (Vercel Cron lo envía automáticamente)
CRON_SECRET=
